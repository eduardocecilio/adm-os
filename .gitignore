# --- AMBIENTES VIRTUAIS (NUNCA ENVIAR) ---
venv/
.venv/
env/
venv.bak/

# --- AMBIENTE, SEGREDOS & CONFIGURACAO LOCAL ---
# Nega por padrao qualquer variante de env, inclusive stack.env e .env.production.
.env
.env.*
*.env
*.env.*
.envrc
.envrc.*
.direnv/
secrets/
*.pem
*.key
*.p12
*.pfx
docker-compose.override.yml
docker-compose.override.yaml

# Allowlist explicita: somente modelos sem credenciais reais podem ser versionados.
!.env.example
!*.env.example
!.env.sample
!*.env.sample

# --- IDE / EDITOR ---
# Ignora configurações locais do VS Code (incluindo a pasta que acabamos de apagar)
.idea/
.vscode/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln

# --- SISTEMA OPERACIONAL (WINDOWS/MAC) ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- BANCO DE DADOS LOCAL ---
# Ignora o banco de dados local para não sobrescrever dados reais
*.sqlite3
*.db
*.sqlite

# --- ARQUIVOS DE DADOS / EXPORTAÇÃO ---
*.xlsx
*.xls
*.csv
*.pdf

# --- TESTES ---
.pytest_cache/
.coverage
htmlcov/
