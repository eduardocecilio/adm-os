# Copie este arquivo para .env. Os tres campos obrigatorios abaixo ficam
# vazios de proposito: o Compose recusara iniciar enquanto eles nao forem
# preenchidos com valores unicos. Nunca versione o .env preenchido.

# Obrigatorios: gere tres valores diferentes com `openssl rand -hex 32`.
SECRET_KEY=
RESET_SECRET_KEY=
POSTGRES_PASSWORD=

# Identificadores locais, nao secretos.
POSTGRES_USER=adm_os
POSTGRES_DB=adm_os

# A demonstracao publica somente portas no loopback da maquina.
APP_PORT=8082
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:8082

# VITE_API_URL e incorporada ao JavaScript entregue ao navegador.
# Nunca coloque tokens ou outros segredos em variaveis VITE_*.
VITE_API_URL=/api

# Integracao opcional de e-mail. Deixe vazia para a demonstracao local.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
EMAIL_FROM=
