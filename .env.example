# ============================================================
# BACKEND
# ============================================================

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://adm_user:senha_segura@adm-os-db:5432/adm_os

# JWT — gere valores únicos com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere_um_valor_seguro_aqui
RESET_SECRET_KEY=gere_outro_valor_seguro_aqui

# Email via n8n webhook
N8N_WEBHOOK_URL=https://n8n.seudominio.com/webhook/enviar-email
N8N_WEBHOOK_TOKEN=seu_token_n8n
EMAIL_FROM=Adm OS <nao-responda@seudominio.com>

# URL pública do frontend (usada em links de e-mail e CORS)
FRONTEND_URL=https://seudominio.com

# ============================================================
# DATABASE (variáveis do container PostgreSQL)
# ============================================================
POSTGRES_USER=adm_user
POSTGRES_PASSWORD=senha_segura
POSTGRES_DB=adm_os

# ============================================================
# FRONTEND (build arg — passado em docker-compose build)
# ============================================================
VITE_API_URL=/api
